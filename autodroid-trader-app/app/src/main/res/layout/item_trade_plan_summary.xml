<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/trading_red"
    android:padding="16dp"
    android:elevation="8dp">

    <!-- Status Selection with Statistics -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:columnCount="3"
        android:rowCount="2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <CheckBox
                android:id="@+id/checkbox_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全部"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:buttonTint="@android:color/white" />

            <TextView
                android:id="@+id/text_all_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <CheckBox
                android:id="@+id/checkbox_pending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="待批准"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:buttonTint="@android:color/white" />

            <TextView
                android:id="@+id/text_pending_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <CheckBox
                android:id="@+id/checkbox_approved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已批准"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:buttonTint="@android:color/white" />

            <TextView
                android:id="@+id/text_approved_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <CheckBox
                android:id="@+id/checkbox_rejected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已否决"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:buttonTint="@android:color/white" />

            <TextView
                android:id="@+id/text_rejected_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <CheckBox
                android:id="@+id/checkbox_completed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="执行成功"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:buttonTint="@android:color/white" />

            <TextView
                android:id="@+id/text_completed_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <CheckBox
                android:id="@+id/checkbox_failed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="执行失败"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:buttonTint="@android:color/white" />

            <TextView
                android:id="@+id/text_failed_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:layout_marginStart="4dp" />

        </LinearLayout>

    </GridLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Complete Button -->
        <Button
            android:id="@+id/btn_complete"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="完成"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:background="@drawable/button_background"
            android:visibility="gone" />

        <!-- Execute Approved Plans Button -->
        <Button
            android:id="@+id/btn_execute_approved"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="执行已批准的交易计划"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:background="@drawable/button_background" />

    </LinearLayout>

</LinearLayout>