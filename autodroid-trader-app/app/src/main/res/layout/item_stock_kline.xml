<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="K线图"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/kline_timeframe_1m"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingHorizontal="12dp"
                    android:text="分时"
                    android:textSize="12sp"
                    android:textColor="@android:color/white"
                    android:background="@android:color/holo_blue_light"
                    android:gravity="center"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/kline_timeframe_day"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingHorizontal="12dp"
                    android:text="日K"
                    android:textSize="12sp"
                    android:textColor="@android:color/black"
                    android:background="@android:color/darker_gray"
                    android:gravity="center"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/kline_timeframe_week"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingHorizontal="12dp"
                    android:text="周K"
                    android:textSize="12sp"
                    android:textColor="@android:color/black"
                    android:background="@android:color/darker_gray"
                    android:gravity="center"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/kline_timeframe_month"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingHorizontal="12dp"
                    android:text="月K"
                    android:textSize="12sp"
                    android:textColor="@android:color/black"
                    android:background="@android:color/darker_gray"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/kline_timeframe_5m"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingHorizontal="12dp"
                    android:text="5分"
                    android:textSize="12sp"
                    android:textColor="@android:color/black"
                    android:background="@android:color/darker_gray"
                    android:gravity="center"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/kline_timeframe_30m"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingHorizontal="12dp"
                    android:text="30分"
                    android:textSize="12sp"
                    android:textColor="@android:color/black"
                    android:background="@android:color/darker_gray"
                    android:gravity="center"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/kline_timeframe_60m"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingHorizontal="12dp"
                    android:text="60分"
                    android:textSize="12sp"
                    android:textColor="@android:color/black"
                    android:background="@android:color/darker_gray"
                    android:gravity="center"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/kline_timeframe_120m"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingHorizontal="12dp"
                    android:text="120分"
                    android:textSize="12sp"
                    android:textColor="@android:color/black"
                    android:background="@android:color/darker_gray"
                    android:gravity="center"
                    android:layout_marginEnd="4dp" />


            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

    <com.github.mikephil.charting.charts.CandleStickChart
        android:id="@+id/kline_chart"
        android:layout_width="match_parent"
        android:layout_height="300dp" />

</LinearLayout>
