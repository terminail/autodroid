<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp">

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="8"
        android:paddingBottom="4dp"
        android:rowCount="3">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="高"
            android:textColor="@android:color/darker_gray"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/stock_daily_high"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_columnWeight="2"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="26.65"
            android:textColor="@android:color/holo_red_dark"
            android:textSize="10sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="市值"
            android:textColor="@android:color/darker_gray"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/stock_daily_market_cap"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="3"
            android:layout_columnWeight="2"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="191.14亿"
            android:textColor="@android:color/black"
            android:textSize="10sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="4"
            android:layout_columnWeight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="量比"
            android:textColor="@android:color/darker_gray"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/stock_daily_volume_ratio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="5"
            android:layout_columnWeight="2"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="0.77"
            android:textColor="@android:color/black"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/stock_daily_turnover2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_rowSpan="2"
            android:layout_column="6"
            android:layout_columnWeight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="26.58"
            android:textColor="@android:color/holo_red_dark"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="1"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="低"
            android:textColor="@android:color/darker_gray"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/stock_daily_low"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_columnWeight="2"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="25.01"
            android:textColor="@android:color/holo_green_dark"
            android:textSize="10sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="1"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="流通"
            android:textColor="@android:color/darker_gray"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/stock_daily_float_cap"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="1"
            android:layout_column="3"
            android:layout_columnWeight="2"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="188.7亿"
            android:textColor="@android:color/black"
            android:textSize="10sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="1"
            android:layout_column="4"
            android:layout_columnWeight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="换"
            android:textColor="@android:color/darker_gray"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/stock_daily_turnover_rate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="1"
            android:layout_column="5"
            android:layout_columnWeight="2"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="6.97%"
            android:textColor="@android:color/black"
            android:textSize="10sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="2"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="开"
            android:textColor="@android:color/darker_gray"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/stock_daily_open"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="2"
            android:layout_column="1"
            android:layout_columnWeight="2"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="25.01"
            android:textColor="@android:color/black"
            android:textSize="10sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="2"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="市盈"
            android:textColor="@android:color/darker_gray"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/stock_daily_pe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="2"
            android:layout_column="3"
            android:layout_columnWeight="2"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="亏损"
            android:textColor="@android:color/holo_green_dark"
            android:textSize="10sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="2"
            android:layout_column="4"
            android:layout_columnWeight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="额"
            android:textColor="@android:color/darker_gray"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/stock_daily_turnover1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="2"
            android:layout_column="5"
            android:layout_columnWeight="2"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="12.90亿"
            android:textColor="@android:color/black"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/stock_daily_turnover3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="2"
            android:layout_column="6"
            android:layout_columnWeight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="0.77/3.84%"
            android:textColor="@android:color/holo_red_light"
            android:textSize="10sp" />

    </GridLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="4dp">

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_weight="0"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/kline_timeframe_1m"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="4dp"
                    android:background="@android:color/holo_blue_light"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingHorizontal="12dp"
                    android:text="分时"
                    android:textColor="@android:color/white"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/kline_timeframe_day"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="4dp"
                    android:background="@android:color/darker_gray"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingHorizontal="12dp"
                    android:text="日K"
                    android:textColor="@android:color/black"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/kline_timeframe_week"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="4dp"
                    android:background="@android:color/darker_gray"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingHorizontal="12dp"
                    android:text="周K"
                    android:textColor="@android:color/black"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/kline_timeframe_month"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@android:color/darker_gray"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingHorizontal="12dp"
                    android:text="月K"
                    android:textColor="@android:color/black"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/kline_timeframe_5m"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="4dp"
                    android:background="@android:color/darker_gray"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingHorizontal="12dp"
                    android:text="5分"
                    android:textColor="@android:color/black"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/kline_timeframe_30m"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="4dp"
                    android:background="@android:color/darker_gray"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingHorizontal="12dp"
                    android:text="30分"
                    android:textColor="@android:color/black"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/kline_timeframe_60m"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="4dp"
                    android:background="@android:color/darker_gray"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingHorizontal="12dp"
                    android:text="60分"
                    android:textColor="@android:color/black"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/kline_timeframe_120m"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="4dp"
                    android:background="@android:color/darker_gray"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingHorizontal="12dp"
                    android:text="120分"
                    android:textColor="@android:color/black"
                    android:textSize="11sp" />
            </LinearLayout>

        </HorizontalScrollView>

        <com.github.mikephil.charting.charts.CandleStickChart
            android:id="@+id/kline_chart"
            android:layout_width="match_parent"
            android:layout_height="200dp" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/kline_viewpager"
            android:layout_width="match_parent"
            android:layout_height="150dp" />
    </LinearLayout>
</LinearLayout>