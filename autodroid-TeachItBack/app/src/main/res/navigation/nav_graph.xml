<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_topics">

    <!-- 主页面 -->
    <fragment
        android:id="@+id/nav_topics"
        android:name="com.autodroid.teachitback.ui.TopicsFragment"
        android:label="学习主题">
        <action
            android:id="@+id/action_nav_topics_to_chat"
            app:destination="@id/nav_chat">
            <argument
                android:name="topicId"
                app:argType="string" />
            <argument
                android:name="topicTitle"
                app:argType="string" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/nav_chat"
        android:name="com.autodroid.teachitback.ui.ChatFragment"
        android:label="聊天">
        <argument
            android:name="topicId"
            app:argType="string" />
        <argument
            android:name="topicTitle"
            app:argType="string" />
    </fragment>

    <!-- 设置相关页面 -->
    <fragment
        android:id="@+id/nav_settings"
        android:name="com.autodroid.teachitback.ui.SettingsFragment"
        android:label="设置">
        <!-- 设置页面到各个子页面的导航 -->
        <action
            android:id="@+id/action_nav_settings_to_preferences"
            app:destination="@id/nav_preferences" />
        <action
            android:id="@+id/action_nav_settings_to_about"
            app:destination="@id/nav_about" />
        <action
            android:id="@+id/action_nav_settings_to_why"
            app:destination="@id/nav_why" />
        
        <!-- AI服务设置页面导航 - 统一使用 SettingsAIServiceDetailFragment -->
        <action
            android:id="@+id/action_nav_settings_to_ai_service_detail"
            app:destination="@id/nav_ai_service_detail">
            <argument
                android:name="config_type"
                app:argType="string" />
        </action>
    </fragment>

    <!-- 个人偏好设置 -->
    <fragment
        android:id="@+id/nav_preferences"
        android:name="com.autodroid.teachitback.ui.PreferencesFragment"
        android:label="个人偏好" />

    <!-- 关于页面 -->
    <fragment
        android:id="@+id/nav_about"
        android:name="com.autodroid.teachitback.ui.AboutFragment"
        android:label="关于" />

    <!-- 为什么页面 -->
    <fragment
        android:id="@+id/nav_why"
        android:name="com.autodroid.teachitback.ui.WhyFragment"
        android:label="为什么">
        <action
            android:id="@+id/action_whyFragment_to_chatFragment"
            app:destination="@id/nav_chat">
            <argument
                android:name="topicId"
                app:argType="string" />
            <argument
                android:name="topicTitle"
                app:argType="string" />
        </action>
        <action
            android:id="@+id/action_whyFragment_to_presetDetailFragment"
            app:destination="@id/presetDetailFragment">
            <argument
                android:name="topic_id"
                app:argType="string" />
            <argument
                android:name="topic_title"
                app:argType="string" />
            <argument
                android:name="topic_description"
                app:argType="string" />
        </action>
    </fragment>

    <!-- 预置课程详情页 -->
    <fragment
        android:id="@+id/presetDetailFragment"
        android:name="com.autodroid.teachitback.ui.PresetDetailFragment"
        android:label="课程详情">
        <argument
            android:name="topic_id"
            app:argType="string" />
        <argument
            android:name="topic_title"
            app:argType="string" />
        <argument
            android:name="topic_description"
            app:argType="string" />
        <action
            android:id="@+id/action_presetDetailFragment_to_chatFragment"
            app:destination="@id/nav_chat">
            <argument
                android:name="topicId"
                app:argType="string" />
            <argument
                android:name="topicTitle"
                app:argType="string" />
        </action>
    </fragment>

    <!-- AI服务详细设置页面 - 统一使用 SettingsAIServiceDetailFragment -->
    <fragment
        android:id="@+id/nav_ai_service_detail"
        android:name="com.autodroid.teachitback.ui.SettingsAIServiceDetailFragment"
        android:label="AI服务配置">
        <argument
            android:name="config_type"
            app:argType="string" />
    </fragment>
</navigation>