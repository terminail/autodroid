<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 第一部分：父路径导航 -->
  
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_section"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/breadcrumb_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:flexWrap="wrap"
            app:alignItems="center"
            app:justifyContent="flex_start" />

    </LinearLayout>

    <!-- 第二部分：当前节点信息 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="当前信息"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@android:color/darker_gray"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_section"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/current_node_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="当前节点标题"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/current_node_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="进度：0%"
                android:textSize="12sp"
                android:textColor="@android:color/darker_gray"
                android:layout_gravity="center_vertical" />

            <ProgressBar
                android:id="@+id/current_node_progress_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_gravity="center_vertical"
                android:progress="0"
                android:max="100"
                android:progressTint="@color/colorPrimary" />

        </LinearLayout>

    </LinearLayout>

    <!-- 第三部分：子节点 -->
    <TextView
        android:id="@+id/children_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="子节点"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@android:color/darker_gray"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/children_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_section"
        android:padding="12dp" />

</LinearLayout>