      ]
    },
    "phase_3": {
      "name": "统一配置界面",
      "duration": "2-3周",
      "deliverables": [
        "动态配置界面UI",
        "配置数据持久化",
        "配置验证和测试"
      ]
    },
    "phase_4": {
      "name": "高级功能集成",
      "duration": "2-3周",
      "deliverables": [
        "多AI服务完整集成",
        "智能路由优化",
        "性能监控和调优"
      ]
    }
  },

  "ai_service_models": {
