<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_import_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="请确认以下信息"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="接收到的加密数据："
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="150dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_ward_shared_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="暂无待导入的被监护人信息"
            android:textSize="12sp"
            android:padding="8dp"
            android:background="#F5F5F5"
            android:fontFamily="monospace" />

    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="说明：\n1. 接收到的是被监护人分享的加密数据\n2. 确认导入后将自动解密并保存被监护人信息到联系人列表\n3. 手机号码、报警密码、邮箱信息等将安全存储"
        android:textSize="12sp"
        android:textColor="#666666"
        android:lineSpacingExtra="2dp"
        android:layout_marginTop="8dp" />

</LinearLayout>
