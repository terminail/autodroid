<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="普通报警灵敏度"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <SeekBar
        android:id="@+id/seek_bar_normal_sensitivity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="10"
        android:progress="3"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_normal_sensitivity_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="当前值: 3级"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="紧急报警灵敏度"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <SeekBar
        android:id="@+id/seek_bar_emergency_sensitivity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="10"
        android:progress="5"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_emergency_sensitivity_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="当前值: 5级"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

</LinearLayout>