<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <CheckBox
        android:id="@+id/cb_recording_enabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="启用报警录音"
        android:checked="true"
        android:layout_marginBottom="16dp" />

    <!-- 录音时长设置 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="录音总时长（分钟）"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />

    <SeekBar
        android:id="@+id/seek_bar_recording_duration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="30"
        android:progress="5"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_recording_duration_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="当前值: 5分钟"
        android:gravity="center"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <!-- 分段录音时长设置 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="分段录音时长（分钟）"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />

    <SeekBar
        android:id="@+id/seek_bar_segment_duration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="10"
        android:progress="2"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_segment_duration_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="当前值: 2分钟"
        android:gravity="center"
        android:textSize="14sp" />

</LinearLayout>
