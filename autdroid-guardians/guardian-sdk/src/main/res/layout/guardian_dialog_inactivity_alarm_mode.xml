<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <CheckBox
        android:id="@+id/cb_inactivity_alarm_enabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="启用长时间未使用手机报警"
        android:checked="true"
        android:layout_marginBottom="16dp" />

    <!-- 普通报警设置 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="普通报警设置"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="未使用时间阈值（分钟）"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />

    <SeekBar
        android:id="@+id/seek_bar_normal_inactivity_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="1440"
        android:progress="60"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_normal_inactivity_time_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="当前值: 60分钟"
        android:gravity="center"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <!-- 紧急报警设置 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="紧急报警设置"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="未使用时间阈值（分钟）"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />

    <SeekBar
        android:id="@+id/seek_bar_emergency_inactivity_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="1440"
        android:progress="30"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_emergency_inactivity_time_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="当前值: 30分钟"
        android:gravity="center"
        android:textSize="14sp" />

</LinearLayout>
