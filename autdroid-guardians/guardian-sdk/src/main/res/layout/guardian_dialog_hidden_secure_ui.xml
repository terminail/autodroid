<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 隐秘界面开关 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tv_hidden_ui_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="隐秘界面开启"
            android:textSize="16sp"
            android:textColor="@android:color/black" />

        <Switch
            android:id="@+id/switch_hidden_ui_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />

    </LinearLayout>

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"
        android:layout_marginVertical="8dp" />

    <!-- 短信开门密语设置 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="短信开门密语"
        android:textSize="14sp"
        android:textColor="@android:color/black"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/et_door_passphrase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="请输入开门密语（默认：小兔子乖乖把门开开）"
        android:text="小兔子乖乖把门开开"
        android:textSize="14sp" />

    <!-- 说明文字 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="说明：\n• 如果隐秘界面关闭，只能通过短信开门密语开启\n• 如果隐秘界面开启，可以通过植入SDK的应用打开\n• 接收到开门密语核对正确后会打开隐秘界面\n• 只有自己的手机发给自己的短信才会触发"
        android:textSize="12sp"
        android:textColor="@android:color/darker_gray"
        android:layout_marginTop="16dp"
        android:lineSpacingExtra="4dp" />

</LinearLayout>