<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <CheckBox
        android:id="@+id/cb_email_enabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="启用报警邮件发送"
        android:checked="false"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="邮箱地址"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_email_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="请输入邮箱地址"
        android:inputType="textEmailAddress"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tv_email_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="邮箱格式不正确"
        android:textSize="12sp"
        android:textColor="#FF0000"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="邮箱密码"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_email_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="请输入邮箱密码（Gmail请使用应用专用密码）"
        android:inputType="textPassword"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SMTP服务器"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_smtp_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="smtp.gmail.com"
        android:inputType="textUri"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SMTP端口"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_smtp_port"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="587"
        android:inputType="number"
        android:layout_marginBottom="12dp" />

    <CheckBox
        android:id="@+id/cb_use_tls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="使用TLS加密"
        android:checked="true" />

</LinearLayout>
