<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="位置密码本设置"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="设置11个字分别代表0-9和小数点："
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <!-- 数字0-3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0:"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_password_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="🀄️"
            android:maxLength="5"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1:"
            android:textSize="14sp"
            android:layout_marginStart="8dp" />

        <EditText
            android:id="@+id/et_password_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="我"
            android:maxLength="5"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2:"
            android:textSize="14sp"
            android:layout_marginStart="8dp" />

        <EditText
            android:id="@+id/et_password_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="向"
            android:maxLength="5"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- 数字3-6 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="3:"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_password_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="送"
            android:maxLength="5"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="4:"
            android:textSize="14sp"
            android:layout_marginStart="8dp" />

        <EditText
            android:id="@+id/et_password_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="说"
            android:maxLength="5"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="5:"
            android:textSize="14sp"
            android:layout_marginStart="8dp" />

        <EditText
            android:id="@+id/et_password_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="去"
            android:maxLength="5"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- 数字6-9 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="6:"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_password_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="劳"
            android:maxLength="5"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="7:"
            android:textSize="14sp"
            android:layout_marginStart="8dp" />

        <EditText
            android:id="@+id/et_password_7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="基"
            android:maxLength="5"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="8:"
            android:textSize="14sp"
            android:layout_marginStart="8dp" />

        <EditText
            android:id="@+id/et_password_8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="🉐"
            android:maxLength="5"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- 数字9和小数点 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="9:"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_password_9"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="吧"
            android:maxLength="5"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=".:"
            android:textSize="14sp"
            android:layout_marginStart="8dp" />

        <EditText
            android:id="@+id/et_password_dot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="口"
            android:maxLength="5"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- 操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_generate_random"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="一键生成"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_reset_default"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="重置默认"
            android:textSize="14sp"
            android:layout_marginStart="8dp" />

        <Button
            android:id="@+id/btn_share"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="分享"
            android:textSize="14sp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>