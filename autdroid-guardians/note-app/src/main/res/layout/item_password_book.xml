<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- 图标 -->
    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_password_book"
        android:layout_marginEnd="16dp" />

    <!-- 内容区域 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 标题 -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="位置密码本"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <!-- 密码本状态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <!-- 启用状态 -->
            <TextView
                android:id="@+id/tv_enabled_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已启用"
                android:textSize="12sp"
                android:textColor="@android:color/holo_green_dark"
                android:background="@drawable/bg_status_enabled"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp" />

            <!-- 密码数量 -->
            <TextView
                android:id="@+id/tv_password_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12个密码"
                android:textSize="12sp"
                android:textColor="@android:color/darker_gray"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- 同步信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <!-- 最后同步时间 -->
            <TextView
                android:id="@+id/tv_last_sync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="最后同步：今天 14:30"
                android:textSize="12sp"
                android:textColor="@android:color/darker_gray" />

        </LinearLayout>

        <!-- 示例密码 -->
        <TextView
            android:id="@+id/tv_password_example"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="示例：31.2304 → 苹果三幺了苹果两三洞四"
            android:textSize="10sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- 右侧箭头 -->
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_arrow_right"
        android:layout_gravity="center_vertical" />

</LinearLayout>