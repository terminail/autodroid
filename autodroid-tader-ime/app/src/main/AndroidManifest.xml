<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.autodroid.trader.ime">



    <application
        android:allowBackup="false">

        <service
            android:name=".TraderIME"
            android:label="AutoDroid Trader IME"
            android:enabled="true"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <service
            android:name=".TraderImeService"
            android:label="Trader IME"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false"
            tools:ignore="AccessibilityPolicy">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".AccessibilityDumpTriggerService"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".AccessibilityDumpReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.autodroid.trader.ACCESSIBILITY_DUMP_REQUEST" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
